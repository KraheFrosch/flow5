QMAKE_TARGET  = fl5-lib
DESTDIR       = 
TARGET        = libfl5-lib.so.1.0.0
TARGETA       = libfl5-lib.a
TARGET0       = libfl5-lib.so
TARGETD       = libfl5-lib.so.1.0.0
TARGET1       = libfl5-lib.so.1
TARGET2       = libfl5-lib.so.1.0


first: all
####### Build rules

libfl5-lib.so.1.0.0:  $(OBJECTS) $(SUBLIBS) $(OBJCOMP)  
	-$(DEL_FILE) $(TARGET) $(TARGET0) $(TARGET1) $(TARGET2)
	$(LINK) $(LFLAGS) -o $(TARGET) $(OBJECTS) $(LIBS) $(OBJCOMP)
	-ln -s $(TARGET) $(TARGET0)
	-ln -s $(TARGET) $(TARGET1)
	-ln -s $(TARGET) $(TARGET2)



staticlib: libfl5-lib.a

libfl5-lib.a:  $(OBJECTS) $(OBJCOMP) 
	-$(DEL_FILE) $(TARGETA) 
	$(AR) $(TARGETA) $(OBJECTS)

